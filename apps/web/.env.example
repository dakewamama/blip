# Where the NestJS API is reachable from the Next.js *server* process.
# In dev that's localhost; in Docker it's usually the service name (http://api:8000).
API_ORIGIN=http://localhost:8000

# Browsers never use this — they call same-origin /api, which next.config.mjs
# rewrites to API_ORIGIN. Set this only if you need to bypass the proxy.
# API_INTERNAL_URL=http://localhost:8000/api
