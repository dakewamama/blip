# Where the NestJS API is reachable from the Next.js *server* process.
# In dev that's localhost; in Docker it's usually the service name (http://api:8000).
API_ORIGIN=http://localhost:8000

# Browsers never use this — they call same-origin /api, which next.config.mjs
# rewrites to API_ORIGIN. Set this only if you need to bypass the proxy.
# API_INTERNAL_URL=http://localhost:8000/api

# Which brand this instance is: blip | flick | kite (see lib/brand.ts). Inlined
# at build time, so restart or rebuild after changing it.
# NEXT_PUBLIC_BRAND=blip

# Build output directory. Give each brand its own when running several
# instances from one checkout, e.g. .next-flick.
# NEXT_DIST_DIR=.next

# Privy app ID — turns on real sign-in and the custodial wallet. Must match
# PRIVY_APP_ID on the API (or that brand's PRIVY_APP_ID_<BRAND>). Unset, the
# app runs as a labelled demo with simulated balances.
# NEXT_PUBLIC_PRIVY_APP_ID=
# Running several brands from one .env.local? Give each its own app:
# NEXT_PUBLIC_PRIVY_APP_ID_FLICK=
# NEXT_PUBLIC_PRIVY_APP_ID_KITE=
