# Server
PORT=8000
HOST=0.0.0.0

# Browser origins allowed to call this API *directly*.
# Usually empty: the Next.js app proxies /api/* to here, so requests arrive
# server-to-server with no Origin header and CORS does not apply.
# Set this only for a separate client (mobile app, second front end).
# In development any localhost port is allowed automatically.
CORS_ORIGIN=

# Solana RPC.
# The public endpoint rate-limits getTokenLargestAccounts within a few requests,
# which makes every safety score come back `complete: false`. Use Helius,
# Triton or QuickNode for anything beyond local poking.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# pump.fun read mirrors. The service remembers which host last worked.
# Leave unset to use the built-in list.
# PUMP_API_BASES=https://frontend-api-v3.pump.fun,https://frontend-api-v2.pump.fun

CACHE_TTL_MS=30000

# --- USDC-on-Solana funding (deposit addresses + on-chain credit watcher) ---
# Ported from github.com/dakewamama/onboarding (payments/src/funding).
# Uses SOLANA_RPC_URL above. This is the demo-mode funding lane: it watches a
# wallet the user owns and credits a ledger once a deposit confirms. Custodial
# accounts are funded straight into the held wallet (see Custody below).

# USDC SPL mint. Defaults to mainnet USDC; override on devnet/staging.
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Commitment a deposit must reach before it is credited: "confirmed" or
# "finalized". Use "finalized" for real money.
SOLANA_COMMITMENT=finalized

# Watcher poll interval (ms) and signatures pulled per address per poll.
# FUNDING_POLL_INTERVAL_MS=20000
# FUNDING_PAGE_SIZE=25

# Durable deposit-ledger directory (gitignored). Deposits survive restarts here.
# Attach a persistent volume before real use so the ledger is not lost on redeploy.
# FUNDING_STORE_DIR=.funding-store

# --- Multi-brand ---
# Brands this API serves; each front end sends its id in the x-blip-tenant
# header. Market data is shared; custody is kept apart per brand.
TENANTS=blip,flick,kite

# --- Custody (Privy server wallets) ---
# The app holds one Solana wallet per user per brand. Leave these empty and
# every front end runs in demo mode with simulated balances.
# Any key below can be overridden for one brand with a suffix, e.g.
# PRIVY_APP_ID_FLICK / PRIVY_APP_SECRET_FLICK for a separate Privy app.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional base64 PKCS8 P-256 private key ("wallet-auth:" prefix is fine).
# New wallets are owned by it and every signature needs it, so the app secret
# alone cannot move funds. Back it up — losing it locks those wallets.
PRIVY_AUTHORIZATION_KEY=
# Trades are signed and broadcast only when this is exactly "true". Off, the
# app still shows balances and accepts deposits and withdrawals.
CUSTODY_LIVE_TRADING=false
# Server-side per-trade ceiling in USD, on top of each user's own cap.
CUSTODY_MAX_TRADE_USD=250
# SOL a buy must leave behind for fees and token-account rent.
# CUSTODY_FEE_RESERVE_SOL=0.01
# CUSTODY_PRIORITY_FEE_SOL=0.00005
# Programs a PumpPortal trade may invoke beyond the built-in allowlist.
# CUSTODY_EXTRA_PROGRAMS=
