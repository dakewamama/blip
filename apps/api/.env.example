# Server
PORT=8000
HOST=0.0.0.0

# Browser origins allowed to call this API *directly*.
# Usually empty: the Next.js app proxies /api/* to here, so requests arrive
# server-to-server with no Origin header and CORS does not apply.
# Set this only for a separate client (mobile app, second front end).
# In development any localhost port is allowed automatically.
CORS_ORIGIN=

# Solana RPC.
# The public endpoint rate-limits getTokenLargestAccounts within a few requests,
# which makes every safety score come back `complete: false`. Use Helius,
# Triton or QuickNode for anything beyond local poking.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# pump.fun read mirrors. The service remembers which host last worked.
# Leave unset to use the built-in list.
# PUMP_API_BASES=https://frontend-api-v3.pump.fun,https://frontend-api-v2.pump.fun

CACHE_TTL_MS=30000

# --- USDC-on-Solana funding (deposit addresses + on-chain credit watcher) ---
# Ported from github.com/dakewamama/onboarding (payments/src/funding).
# Uses SOLANA_RPC_URL above. Deposits are watched on the user's own wallet and
# credited only after they confirm on-chain; nothing is ever custodied.

# USDC SPL mint. Defaults to mainnet USDC; override on devnet/staging.
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Commitment a deposit must reach before it is credited: "confirmed" or
# "finalized". Default "confirmed" (responsive for a demo); use "finalized" for
# real money.
SOLANA_COMMITMENT=confirmed

# Watcher poll interval (ms) and signatures pulled per address per poll.
# FUNDING_POLL_INTERVAL_MS=20000
# FUNDING_PAGE_SIZE=25

# Durable deposit-ledger directory (gitignored). Deposits survive restarts here.
# Attach a persistent volume before real use so the ledger is not lost on redeploy.
# FUNDING_STORE_DIR=.funding-store
